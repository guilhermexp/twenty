#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "$script_dir/../../.." && pwd)"

if [ ! -f "$script_dir/.env" ]; then
  echo "Error: .env file not found in $script_dir" >&2
  exit 1
fi

source "$script_dir/.env"

podman build \
  --tag twenty:local \
  --file "$repo_root/packages/twenty-docker/twenty/Dockerfile" \
  "$repo_root"

podman volume create twenty-db-data >/dev/null
podman volume create twenty-server-data >/dev/null
podman volume create twenty-redis-data >/dev/null

podman pod create --name twenty-pod -p 127.0.0.1:8080:3000

podman run -d --pod twenty-pod --name twenty-db \
  -e POSTGRES_DB=twenty \
  -e POSTGRES_USER=twenty \
  -e POSTGRES_PASSWORD="$POSTGRES_PASSWORD" \
  -v twenty-db-data:/var/lib/postgresql/data:Z \
  docker.io/library/postgres:16

podman run -d --pod twenty-pod --name twenty-redis \
  -v twenty-redis-data:/data:Z \
  docker.io/library/redis:latest

podman run -d --pod twenty-pod --name twenty-server \
  -e NODE_PORT=3000 \
  -e SERVER_URL="$SERVER_URL" \
  -e PG_DATABASE_URL="postgresql://twenty:$POSTGRES_PASSWORD@twenty-db:5432/twenty" \
  -e REDIS_URL="redis://twenty-redis:6379" \
  -e APP_SECRET="$APP_SECRET" \
  -e NODE_ENV=production \
  -e LOG_LEVEL=info \
  -v twenty-server-data:/app/docker-data:Z \
  twenty:local

podman run -d --pod twenty-pod --name twenty-worker \
  --init \
  -e SERVER_URL="$SERVER_URL" \
  -e PG_DATABASE_URL="postgresql://twenty:$POSTGRES_PASSWORD@twenty-db:5432/twenty" \
  -e REDIS_URL="redis://twenty-redis:6379" \
  -e APP_SECRET="$APP_SECRET" \
  -e DISABLE_DB_MIGRATIONS=true \
  -e NODE_ENV=production \
  -e LOG_LEVEL=info \
  -v twenty-server-data:/app/docker-data:Z \
  twenty:local \
  yarn worker:prod

sleep 30
podman ps --pod -f name=twenty-pod

mkdir -p ~/.config/systemd/user
if [ ! -f "$script_dir/twenty.service" ]; then
  echo "Error: twenty.service not found in $script_dir" >&2
  exit 1
fi
cp "$script_dir/twenty.service" ~/.config/systemd/user/

systemctl --user daemon-reload
systemctl --user enable twenty.service
systemctl --user start twenty.service
